nfig = { data: filtered, backgroundColor: params.backgroundColor?.[0] || '' };\nmodule.exports = {\n render: Editor.wrapFn({\n  fn: function(dimensions, config) {\n   const W=dimensions.width, H=dimensions.height, m={top:56,right:28,bottom:56,left:58}, pw=W-m.left-m.right, ph=H-m.top-m.bottom;\n   const max=Math.ceil(d3.max(config.data,d=>d.duration)||20)/5*5, x=d3.scaleLinear().domain([1,80]).range([m.left,m.left+pw]), y=d3.scaleLinear().domain([0,max]).range([m.top+ph,m.top]);\n   const color=v=>{const stops=[[0,[216,75,54]],[25,[238,165,88]],[50,[234,223,138]],[75,[154,196,134]],[100,[38,123,85]]];let i=stops.findIndex(s=>v<=s[0]);if(i<1)return `rgb(${stops[0][1]})`;const [aN,a]=stops[i-1],[bN,b]=stops[i],t=(v-aN)/(bN-aN);return `rgb(${a.map((q,j)=>Math.round(q+(b[j]-q)*t)).join(',')})`;};\n   const icons={'Разминка':'▥','Кардио':'♥','Силовая':'▰','Интенсив':'ϟ','Дэнс':'👠','Йога':'🙏'};\n   const svg=d3.create('svg').attr('viewBox',[0,0,W,H]).attr('width',W).attr('height',H).style('font','11px sans-serif');\n   for(let t=0;t<=max;t+=5){const yy=y(t);svg.append('line').attr('x1',m.left).attr('x2',m.left+pw).attr('y1',yy).attr('y2',yy).attr('stroke','#d9ddd5');svg.append('text').attr('x',m.left-10).attr('y',yy+4).attr('text-anchor','end').attr('fill','#718078').text(t);}\n   for(let w=1;w<=10;w++){const center=x((w-1)*8+4);svg.append('text').attr('x',center).attr('y',18).attr('text-anchor','middle').attr('fill','#64736b').style('font-weight','700').text('НЕДЕЛЯ '+w);if(w>1)svg.append('line').attr('x1',x((w-1)*8+.5)).attr('x2',x((w-1)*8+.5)).attr('y1',m.top-10).attr('y2',m.top+ph+24).attr('stroke','#9aa89d').attr('stroke-dasharray','4 6');}\n   config.data.forEach(d=>{const xx=x(d.sort),yy=y(d.duration),r=8+d.depth/100*15;const g=svg.append('g').attr('transform',`translate(${xx},${yy})`);g.append('circle').attr('r',r).attr('fill',color(d.share)).attr('stroke','#53665c');g.append('text').attr('y',-r+10).attr('text-anchor','middle').attr('fill','#26372e').style('font-weight','700').style('font-size','9px').text(d.rating===null?'—':d.rating.toFixed(1));g.append('text').attr('text-anchor','middle').attr('dominant-baseline','central').style('font-size',Math.max(14,r*1.1)+'px').text(icons[d.type]||'');g.append('title').text(`Неделя ${d.week}, ${d.day} · ${d.trainer} · ${d.type}\\nПросмотрели: ${d.share.toFixed(1)}%\\nГлубина: ${d.depth.toFixed(1)}%\\nОценка: ${d.rating===null?'—':d.rating.toFixed(1)}`);});\n   const node=document.createElement('div');node.style.height='100%';node.style.background=config.backgroundColor||'';node.appendChild(svg.node());return Editor.generateHtml(node);\n  }, args:[config], libs:['d3']\n })\n};","sources":"const {buildSource} = require('libs/dataset/v2');\nmodule.exports = {\n  'training_source_dataset': buildSource({ datasetId: Editor.getId('trainings_dataset'), columns: [\"sort_order\", \"code\", \"week\", \"week_label\", \"week_view_share_pct\", \"week_viewers\", \"day\", \"day_order\", \"type\", \"trainer\", \"duration_min\", \"viewers\", \"total_users\", \"viewer_share_pct\", \"depth_avg_pct\", \"rating_avg\", \"rating_count\", \"icon\", \"week_separator\"] }),\n};","controls":"module.exports = {};"},"name":"Тренировки — длительность, просмотры и оценки","type":"d3_wizard_node","version":null,"annotation":{"description":"График тренировок за 10 недель: длительность, доля просмотров, глубина и оценки."}}}},"dash":{"2":{"dash":{"data":{"salt":"0.7188023575058666","tabs":[{"id":"m1","items":[{"id":"Chart","data":{"tabs":[{"id":"ChartTab","hint":"","title":"Тренировки: длительность и просмотры","params":{},"chartId":"8","isDefault":true,"autoHeight":false,"enableHint":false,"description":"","enableDescription":false}],"hideTitle":false,"backgroundSettings":{}},"type":"widget","namespace":"default"},{"id":"Trainer","data":{"group":[{"id":"tr","title":"Тренер","width":"","source":{"isRange":false,"required":false,"showHint":false,"datasetId":"5","fieldType":"string","showTitle":true,"accentType":null,"i